---
import "@/styles/globals.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Navbar from "../components/Navbar.astro";
import PixelParallaxScene from "../components/PixelParallaxScene.astro";

interface Props {
  title?: string;
  description?: string;
  /** The parallax scene has no scrim, so any page whose content sits directly
   *  on it becomes unreadable. Off for pages that are mostly prose. */
  scene?: boolean;
}

const {
  scene = true,
  title = "Syahrul Bhudi Ferdiansyah – Portfolio",
  description = "The official portfolio of Syahrul Bhudi Ferdiansyah, a Full-Stack Developer showcasing technical expertise in building scalable and efficient web applications using modern technologies such as Next.js, SvelteKit, TypeScript, Laravel, and Golang.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://ryuko.my.id");
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
    <link rel="icon" type="image/svg+xml" href="/logo.svg"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
    <link rel="manifest" href="/favicon_io/site.webmanifest">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <meta name="generator" content={Astro.generator}/>
    <meta name="description" content={description}/>
    <meta name="author" content="Syahrul Bhudi Ferdiansyah"/>
    <meta name="keywords" content="Syahrul, Bhudi, Ferdiansyah, Portfolio, Web Developer, Software Engineer, Next.js, SvelteKit, TypeScript, Laravel, Golang, DevOps, Backend Developer, Frontend Developer, Database"/>
    <link rel="canonical" href={canonical}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content="website"/>
    <title>{title}</title>
    {import.meta.env.DEV && (
      <script>
        import { scan } from "react-scan";

        scan({ enabled: true });
      </script>
    )}
</head>
<body class={`overflow-x-hidden ${scene ? "bg-[#241735]" : "bg-linear-to-b from-[#0a060f] via-[#201529] to-[#361d41] bg-fixed"}`}>
<a href="#home" class="skip-link">Skip to main content</a>
{scene && <PixelParallaxScene />}
<slot/>
<Navbar/>
<SpeedInsights/>
<Analytics/>
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
    }
</style>
