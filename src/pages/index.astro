---
import Project from "@/components/content/Project.astro";
import SplashScreen from "../components/SplashScreen";
import About from "../components/content/About.astro";
import Collaborate from "../components/content/Collaborate.astro";
import Experience from "../components/content/Experience.astro";
import Home from "../components/content/Home.astro";
import OpenSource from "../components/content/OpenSource.astro";
import Layout from "../layouts/Layout.astro";
---

{/* Layout renders the whole document, so nothing may sit outside it — a wrapper
    element here pushes <html> past the parser's implicit <body>, the stylesheet
    links land in the body, and the page paints unstyled first. */}
<Layout>
    <SplashScreen client:load/>
    <Home/>
    <About/>
    <Experience/>
    <OpenSource/>
    <Project/>
    <Collaborate/>
</Layout>
