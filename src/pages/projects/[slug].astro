---
import { type CollectionEntry, getCollection, render } from "astro:content";
import GitHubStars from "@/components/GitHubStars";
import ProjectGallery from "@/components/ProjectGallery";
import TechStackItem from "@/components/ui/TechStackItem";
import Layout from "@/layouts/Layout.astro";
import { getGitHubStars } from "@/lib/github";

type Project = CollectionEntry<"projects">;

const projectSlug = (project: Project) => project.data.slug ?? project.id;

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const sorted = projects.sort((a, b) => (a.data.date > b.data.date ? -1 : 1));

  // One stars fetch for the whole build rather than one per generated page.
  const stars = await getGitHubStars(
    sorted.flatMap(({ data }) => [data.sourceClient, data.sourceServer, data.sourceModel]),
  );

  return sorted.map((project, index) => ({
    params: { slug: project.data.slug ?? project.id },
    props: {
      project,
      stars: [project.data.sourceClient, project.data.sourceServer, project.data.sourceModel]
        .flatMap((url) => (url ? [url] : []))
        .reduce((total, url) => total + (stars[url] ?? 0), 0),
      previous: sorted[index - 1] ?? null,
      next: sorted[index + 1] ?? null,
    },
  }));
}

interface Props {
  project: Project;
  stars: number;
  previous: Project | null;
  next: Project | null;
}

const { project, stars, previous, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
// Three of the projects have no MDX body; without this the heading and its
// rule would render over nothing.
const hasOverview = Boolean(project.body?.trim());

const assetBase = `/assets/projects/${project.id}`;
const cover = data.hasImage ? `${assetBase}/cover.webp` : null;
const gallery = data.gallery.map((image) => ({
  ...image,
  src: `${assetBase}/${image.src}`,
}));

const dateLabel = data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
const meta = [data.type, data.role, dateLabel].filter(Boolean).join(" · ");

const sourceLinks = [
  { url: data.sourceClient, label: "Client Source" },
  { url: data.sourceServer, label: "Server Source" },
  { url: data.sourceModel, label: "Model Source" },
].flatMap((link) => (link.url ? [{ ...link, url: link.url }] : []));
---

<Layout
        title={`${data.title} – Syahrul Bhudi Ferdiansyah`}
        description={data.description}
        scene={false}
>
    <main class="relative z-10 flex w-full justify-center px-16 pt-16 pb-32 text-white max-md:px-4 max-md:pt-16">
        <article class="flex w-full max-w-5xl flex-col gap-7">
            <a
                    href="/#projects"
                    class="pixel-tag flex w-fit items-center gap-2 px-3 py-1.5 font-mono text-xs tracking-[0.16em] text-white uppercase outline-none transition-transform duration-200 ease-out hover:-translate-x-0.5 focus-visible:-translate-x-0.5"
            >
                &lsaquo; Back to projects
            </a>

            <header class="flex flex-col gap-1.5">
                <div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-1">
                    <h1 class="text-retro-card text-5xl leading-tight max-sm:text-3xl">{data.title}</h1>
                    <GitHubStars stars={stars} size={20} className="text-purple-200 text-lg"/>
                </div>
                <p class="font-mono text-xs tracking-[0.16em] text-purple-300/70 uppercase">{meta}</p>
            </header>

            {cover && (
                    <div class="pixel-photo">
                        {/* Natural ratio rather than a forced 16/9 — covers run
                            from 1.41 to 1.86, and one ratio cropped the tallest
                            by a fifth. max-h keeps even the tallest above the
                            fold; object-contain means it shrinks, never crops. */}
                        <img src={cover} alt={`${data.title} cover`} class="max-h-[70vh] w-full object-contain" loading="eager"/>
                    </div>
            )}

            <div class="flex flex-col gap-4">
                <p class="max-w-3xl text-base leading-relaxed text-gray-300">{data.description}</p>

                {(data.demo || sourceLinks.length > 0) && (
                        <div class="flex flex-wrap gap-3">
                            {data.demo && (
                                    <a
                                            href={data.demo}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="pixel-tag flex items-center gap-2 px-4 py-1.5 text-sm text-white outline-none transition-transform duration-200 ease-out hover:-translate-y-0.5 focus-visible:-translate-y-0.5"
                                    >
                                        Live Demo
                                    </a>
                            )}
                            {sourceLinks.map((link) => (
                                    <a
                                            href={link.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="pixel-tag flex items-center gap-2 px-4 py-1.5 text-sm text-white outline-none transition-transform duration-200 ease-out hover:-translate-y-0.5 focus-visible:-translate-y-0.5"
                                    >
                                        <img src="/assets/icon/github.svg" alt="" width={15} height={15} loading="lazy"/>
                                        {link.label}
                                    </a>
                            ))}
                        </div>
                )}
            </div>

            <!-- Single column: a 17rem rail could not hold a 13-item stack
                 without going ragged, and it left a tall void beside a short
                 overview. Full width lets the stack sit on an even grid. -->
            <div class="flex flex-col gap-10">
                    {hasOverview && (
                            <section>
                                <p class="font-mono text-[0.6875rem] tracking-[0.2em] text-purple-300/70 uppercase">Overview</p>
                                <div class="mt-3 border-t-2 border-[#652682] pt-4 leading-[1.75] text-white/80 [&>*+*]:mt-4 [&_a]:text-[#d8aef0] [&_a]:underline [&_a]:underline-offset-[3px] [&_code]:bg-[#2a1236] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.875em] [&_h2]:mt-7 [&_h2]:font-['VT323'] [&_h2]:text-2xl [&_h2]:leading-tight [&_h2]:text-white [&_h3]:mt-7 [&_h3]:font-['VT323'] [&_h3]:text-2xl [&_h3]:leading-tight [&_h3]:text-white [&_li+li]:mt-1.5 [&_ol]:list-decimal [&_ol]:pl-5 [&_pre]:overflow-x-auto [&_pre]:bg-[#2a1236] [&_pre]:p-4 [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_ul]:list-disc [&_ul]:pl-5">
                                    <Content/>
                                </div>
                            </section>
                    )}

                    {gallery.length > 0 && (
                            <section>
                                <p class="font-mono text-[0.6875rem] tracking-[0.2em] text-purple-300/70 uppercase">Gallery</p>
                                <div class="mt-3 border-t-2 border-[#652682] pt-5">
                                    <ProjectGallery images={gallery} client:visible/>
                                </div>
                            </section>
                    )}

                    <section>
                        <p class="font-mono text-[0.6875rem] tracking-[0.2em] text-purple-300/70 uppercase">Stack</p>
                        <!-- Equal-width tracks, and the gap carries each block's
                             15px shadow now that the chip's own margin is off. -->
                        <div class="mt-3 grid grid-cols-[repeat(auto-fill,minmax(11rem,1fr))] gap-x-6 gap-y-5 border-t-2 border-[#652682] pt-5">
                            {data.stack.map((tech) => (
                                    <TechStackItem tech={tech.name} url={tech.url} size="small" className="m-0 w-full justify-start"/>
                            ))}
                        </div>
                    </section>

                    {data.contributors && data.contributors.length > 0 && (
                            <section>
                                <p class="font-mono text-[0.6875rem] tracking-[0.2em] text-purple-300/70 uppercase">Contributors</p>
                                <ul class="mt-3 flex flex-wrap gap-x-10 gap-y-3 border-t-2 border-[#652682] pt-4">
                                    {data.contributors.map((contributor) => (
                                            <li>
                                                <a
                                                        href={contributor.link ?? "#"}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="flex flex-col outline-none hover:text-purple-100 focus-visible:text-purple-100"
                                                >
                                                    <span class="text-sm text-white">{contributor.name}</span>
                                                    <span class="font-mono text-[0.625rem] tracking-[0.16em] text-purple-300/60 uppercase">{contributor.role}</span>
                                                </a>
                                            </li>
                                    ))}
                                </ul>
                            </section>
                    )}
            </div>

            <nav class="flex flex-wrap items-center justify-between gap-4 border-t-2 border-[#652682] pt-6">
                {previous ? (
                        <a
                                href={`/projects/${projectSlug(previous)}`}
                                class="flex min-w-0 flex-col outline-none hover:text-purple-100 focus-visible:text-purple-100"
                        >
                            <span class="font-mono text-[0.625rem] tracking-[0.2em] text-purple-300/60 uppercase">&lsaquo; Newer</span>
                            <span class="truncate text-sm text-white">{previous.data.title}</span>
                        </a>
                ) : <span/>}

                {next ? (
                        <a
                                href={`/projects/${projectSlug(next)}`}
                                class="flex min-w-0 flex-col text-right outline-none hover:text-purple-100 focus-visible:text-purple-100"
                        >
                            <span class="font-mono text-[0.625rem] tracking-[0.2em] text-purple-300/60 uppercase">Older &rsaquo;</span>
                            <span class="truncate text-sm text-white">{next.data.title}</span>
                        </a>
                ) : <span/>}
            </nav>
        </article>
    </main>
</Layout>
