---
import rinGif from "@/assets/rin.gif";
import { FileUser, Mail } from "lucide-react";
import { GithubIcon, LinkedinIcon } from "../BrandIcons";
import SliderHome from "../SliderHome";

// Square-mask tiles: [class, x, y, w, h] in 800x700 artboard units.
// One source of truth; rendered in both the SVG mask and the outline layer
// so both animate in sync (same class = same CSS keyframes).
const PORTRAIT_TILES: [string, number, number, number, number][] = [
  ["s1", 220, 110, 112, 74], ["s2", 332, 104, 148, 78], ["s3", 480, 116, 92, 61],
  ["s4", 132, 151, 78, 86], ["s5", 190, 160, 140, 100], ["s6", 320, 155, 160, 90],
  ["s7", 470, 150, 126, 85], ["s8", 596, 143, 56, 76],
  ["s9", 94, 222, 96, 106], ["s10", 170, 240, 160, 110], ["s11", 310, 235, 180, 100],
  ["s12", 470, 230, 130, 95], ["s13", 596, 222, 68, 86],
  ["s14", 66, 324, 106, 116], ["s15", 150, 330, 180, 120], ["s16", 310, 325, 200, 110],
  ["s17", 490, 320, 146, 104], ["s18", 626, 312, 76, 96],
  ["s19", 76, 424, 92, 104], ["s20", 145, 430, 170, 100], ["s21", 300, 425, 190, 95],
  ["s22", 470, 420, 150, 90], ["s23", 616, 410, 86, 92],
  ["s24", 94, 512, 76, 86], ["s25", 160, 520, 140, 65], ["s26", 290, 515, 160, 55],
  ["s27", 430, 510, 140, 60], ["s28", 560, 502, 108, 60],
  ["s29", 124, 572, 66, 54], ["s30", 190, 580, 100, 45], ["s31", 290, 575, 120, 40],
  ["s32", 400, 570, 116, 44], ["s33", 516, 562, 86, 42],
  ["f1", 200, 60, 28, 20], ["f2", 300, 52, 38, 30], ["f3", 420, 58, 30, 21],
  ["f4", 540, 55, 34, 31], ["f5", 650, 65, 22, 18],
  ["f6", 50, 170, 24, 22], ["f7", 35, 280, 38, 32], ["f8", 40, 390, 22, 26],
  ["f9", 45, 500, 24, 20], ["f10", 55, 610, 20, 23],
  ["f11", 710, 160, 36, 32], ["f12", 725, 270, 24, 26], ["f13", 730, 380, 22, 22],
  ["f14", 720, 490, 38, 34], ["f15", 710, 600, 24, 21],
  ["f16", 240, 640, 22, 18], ["f17", 380, 635, 38, 32], ["f18", 520, 630, 22, 24],
];

const portraitTiles = PORTRAIT_TILES.map(([cls, x, y, w, h]) => ({
  cls,
  x,
  y,
  w,
  h,
}));



---

<section class="home-hero w-full h-screen overflow-hidden relative flex justify-center px-16 max-md:px-4" id="home">
    <div class="hero-shell flex justify-center lg:justify-between h-full items-center w-full max-w-7xl py-16 z-10 lg:gap-12 max-lg:flex-col max-md:gap-4 max-lg:gap-10 max-lg:py-8">
        <div class="pixel-portrait-wrap max-lg:w-[78%] max-md:w-full" aria-hidden="true" style={`--rin-image: url(${rinGif.src})`}>
            <svg class="sq-scene" viewBox="0 0 800 700" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <defs>
                    <mask id="pixel-sq-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="800" height="700">
                        <rect width="800" height="700" fill="black" />
                        {portraitTiles.map((t) => (
                            <rect class={`sq ${t.cls}`} x={t.x} y={t.y} width={t.w} height={t.h} fill="white" />
                        ))}
                    </mask>
                </defs>
                <g class="sq-outline">
                    {portraitTiles.map((t) => (
                        <rect class={`sq ${t.cls}`} x={t.x} y={t.y} width={t.w} height={t.h} fill="none" stroke="#c4a1ff" stroke-width="3" />
                    ))}
                </g>
                <image class="sq-image" href={rinGif.src} x="0" y="0" width="800" height="700" preserveAspectRatio="xMidYMid slice" mask="url(#pixel-sq-mask)" />
            </svg>
        </div>

        <div class="hero-copy flex flex-col lg:w-[58%] max-lg:w-full max-lg:items-center max-lg:text-center">
            <h1 class="pixel-name text-[#CDA6ED]" aria-label="Syahrul">
                <span class="pixel-bracket title-char title-c1" aria-hidden="true">&lt;</span><span class="title-char title-c2">S</span><span class="title-char title-c3">Y</span><span class="title-char title-c4">A</span><span class="title-char title-c5">H</span><span class="title-char title-c6">R</span><span class="title-char title-c7">U</span><span class="title-char title-c8">L</span><span class="pixel-bracket title-char title-c9" aria-hidden="true">/&gt;</span>
            </h1>
            <p class="real-name text-white">Bhudi Ferdiansyah</p>
            <div class="role-line text-white flex gap-3 items-center max-lg:justify-center">
                <p class="role-prefix whitespace-nowrap">I'm a</p>
                <SliderHome client:idle/>
            </div>
            <div class="hero-socials" aria-label="Social links">
                <a href="assets/cv_syahrul.pdf" download="Syahrul_CV.pdf" aria-label="Download CV">
                    <FileUser size={24}/>
                </a>
                <a href="https://github.com/SyahrulBhudiF" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                    <GithubIcon size={24}/>
                </a>
                <a href="mailto:syahrulbhudif@ryuko.my.id" aria-label="Email">
                    <Mail size={24}/>
                </a>
                <a href="https://www.linkedin.com/in/syahrulbhudif/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                    <LinkedinIcon size={24}/>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .home-hero {
        isolation: isolate;
    }

    .hero-shell {
        position: relative;
    }

    .pixel-portrait-wrap {
        --portrait-size: min(40vw, 525px);
        position: relative;
        isolation: isolate;
        width: var(--portrait-size);
        flex: 0 0 auto;
        filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.2));
    }

    .pixel-portrait-wrap {
        aspect-ratio: 1.42;
    }

    /* Square-mask portrait: one responsive SVG owns the mask, outline, and image. */
    .sq-scene {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        pointer-events: none;
    }

    .sq-outline,
    .sq-image {
        pointer-events: none;
    }

    .sq-image {
        filter: saturate(0.82) contrast(0.92) brightness(0.78);
    }

    /* Tile wobble — mask rects and outline rects share these classes, so both
       layers move in sync. Amplitudes are % of the viewBox/ext-box → responsive. */
    .s1  { animation: dx1 5s ease-in-out infinite; }
    .s2  { animation: dy1 5.5s ease-in-out infinite; }
    .s3  { animation: dx2 6s ease-in-out infinite; }
    .s4  { animation: dy2 5.2s ease-in-out infinite; }
    .s5  { animation: dx3 5.8s ease-in-out infinite; }
    .s6  { animation: dy3 6.5s ease-in-out infinite; }
    .s7  { animation: dx1 6s ease-in-out infinite reverse; }
    .s8  { animation: dy1 5.5s ease-in-out infinite reverse; }
    .s9  { animation: dx2 5s ease-in-out infinite reverse; }
    .s10 { animation: dy2 4.5s ease-in-out infinite; }
    .s11 { animation: dx3 5s ease-in-out infinite; }
    .s12 { animation: dx1 5.5s ease-in-out infinite reverse; }
    .s13 { animation: dy1 6s ease-in-out infinite; }
    .s14 { animation: dx2 5.2s ease-in-out infinite; }
    .s15 { animation: dy2 5.8s ease-in-out infinite reverse; }
    .s16 { animation: dx3 6.5s ease-in-out infinite; }
    .s17 { animation: dy3 5s ease-in-out infinite reverse; }
    .s18 { animation: dx1 5.5s ease-in-out infinite; }
    .s19 { animation: dy1 6s ease-in-out infinite reverse; }
    .s20 { animation: dx2 5s ease-in-out infinite; }
    .s21 { animation: dy2 5.5s ease-in-out infinite; }
    .s22 { animation: dx3 6s ease-in-out infinite reverse; }
    .s23 { animation: dy3 5.2s ease-in-out infinite; }
    .s24 { animation: dx1 5.8s ease-in-out infinite; }
    .s25 { animation: dy1 6.5s ease-in-out infinite reverse; }
    .s26 { animation: dx2 5s ease-in-out infinite reverse; }
    .s27 { animation: dy2 5.5s ease-in-out infinite; }
    .s28 { animation: dx3 6s ease-in-out infinite; }
    .s29 { animation: dy3 5s ease-in-out infinite reverse; }
    .s30 { animation: dx1 5.5s ease-in-out infinite; }
    .s31 { animation: dy1 6s ease-in-out infinite; }
    .s32 { animation: dx2 5.2s ease-in-out infinite reverse; }
    .s33 { animation: dy2 5.8s ease-in-out infinite; }

    .f1  { animation: dx1 4s ease-in-out infinite, dy2 4.5s ease-in-out infinite; }
    .f2  { animation: dx2 3.8s ease-in-out infinite, dy1 4.2s ease-in-out infinite; }
    .f3  { animation: dx3 4.5s ease-in-out infinite, dy3 4s ease-in-out infinite; }
    .f4  { animation: dx1 4.2s ease-in-out infinite reverse, dy2 3.5s ease-in-out infinite; }
    .f5  { animation: dx2 5s ease-in-out infinite, dy1 4.5s ease-in-out infinite reverse; }
    .f6  { animation: dx3 3.5s ease-in-out infinite reverse, dy3 4s ease-in-out infinite; }
    .f7  { animation: dx1 4.8s ease-in-out infinite, dy2 5s ease-in-out infinite reverse; }
    .f8  { animation: dx2 4s ease-in-out infinite, dy1 3.8s ease-in-out infinite; }
    .f9  { animation: dx3 5.5s ease-in-out infinite reverse, dy3 4.5s ease-in-out infinite; }
    .f10 { animation: dx1 3.8s ease-in-out infinite, dy2 4.2s ease-in-out infinite reverse; }
    .f11 { animation: dx2 5s ease-in-out infinite reverse, dy1 4.5s ease-in-out infinite; }
    .f12 { animation: dx3 4s ease-in-out infinite, dy3 5s ease-in-out infinite reverse; }
    .f13 { animation: dx1 4.5s ease-in-out infinite, dy2 5.5s ease-in-out infinite; }
    .f14 { animation: dx2 4.2s ease-in-out infinite reverse, dy1 5s ease-in-out infinite reverse; }
    .f15 { animation: dx3 4.8s ease-in-out infinite, dy3 4s ease-in-out infinite; }
    .f16 { animation: dx1 4s ease-in-out infinite reverse, dy2 4.5s ease-in-out infinite reverse; }
    .f17 { animation: dx2 4.5s ease-in-out infinite, dy1 4.2s ease-in-out infinite; }
    .f18 { animation: dx3 4.2s ease-in-out infinite reverse, dy3 4.8s ease-in-out infinite; }

    @keyframes dx1 { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(1.9%); } }
    @keyframes dx2 { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-1.5%); } }
    @keyframes dx3 { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(1.3%); } }
    @keyframes dy1 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(1.7%); } }
    @keyframes dy2 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-2%); } }
    @keyframes dy3 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(1.4%); } }
    .title-c1 { --title-duration: 3.8s; --title-delay: -1.2s; --title-lift: -3px; --title-scale: 1.06; }
    .title-c2 { --title-duration: 3.1s; --title-delay: -0.4s; --title-lift: -2px; --title-scale: 1.045; }
    .title-c3 { --title-duration: 4.2s; --title-delay: -2.3s; --title-lift: -4px; --title-scale: 1.07; }
    .title-c4 { --title-duration: 3.5s; --title-delay: -1.7s; --title-lift: -2px; --title-scale: 1.05; }
    .title-c5 { --title-duration: 4.5s; --title-delay: -3.1s; --title-lift: -3px; --title-scale: 1.06; }
    .title-c6 { --title-duration: 3.3s; --title-delay: -0.9s; --title-lift: -4px; --title-scale: 1.07; }
    .title-c7 { --title-duration: 4s; --title-delay: -2.8s; --title-lift: -2px; --title-scale: 1.045; }
    .title-c8 { --title-duration: 3.7s; --title-delay: -1.9s; --title-lift: -3px; --title-scale: 1.06; }
    .title-c9 { --title-duration: 4.3s; --title-delay: -3.5s; --title-lift: -4px; --title-scale: 1.07; }

    @keyframes title-breathe {
        0%, 100% { transform: translateY(0) scale(1); }
        50% { transform: translateY(var(--title-lift, -2px)) scale(var(--title-scale, 1.055)); }
    }

    @media (prefers-reduced-motion: reduce) {
        .sq-outline rect,
        .sq-image,
        #pixel-sq-mask rect,
        .title-char {
            animation: none;
        }
    }

    .pixel-name {
        margin: 0;
        font-family: "Silkscreen", "VT323", monospace;
        font-size: clamp(3rem, 6vw, 5rem);
        font-weight: 400;
        line-height: 0.72;
        letter-spacing: 0.055em;
        text-transform: uppercase;
        color: #cda6ed;
        text-shadow: 7px 7px 0 rgb(45 53 83 / 0.55);
        white-space: nowrap;
        transform: none;
    }

    .title-char {
        display: inline-block;
        transform-origin: center bottom;
        animation: title-breathe var(--title-duration) ease-in-out infinite;
        animation-delay: var(--title-delay);
        will-change: transform;
    }

    .pixel-bracket {
        color: #fff;
        letter-spacing: 0;
        margin-inline: 0.02em;
        text-shadow: 5px 5px 0 #cda6ed, 8px 8px 0 rgb(45 53 83 / 0.45);
    }

    .real-name {
        margin-top: 1rem;
        font-size: clamp(1.95rem, 3.4vw, 3.1rem);
        font-weight: 300;
        line-height: 0.92;
        letter-spacing: 0.28em;
        color: #fff;
        white-space: nowrap;
    }

    .role-line {
        margin-top: 1rem;
        font-size: clamp(1.4rem, 2vw, 2rem);
        line-height: 1;
        text-shadow: 4px 4px 0 #6c548f;
    }

    .role-prefix {
        flex: 0 0 auto;
    }

    .hero-socials {
        display: flex;
        gap: 0.9rem;
        margin-top: 1.45rem;
    }

    .hero-socials a {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        color: #081226;
        background: #fff;
        border-radius: 0.42rem;
        box-shadow: 0 5px 0 rgb(0 0 0 / 0.1);
        transition: transform 180ms ease, background-color 180ms ease, color 180ms ease;
    }

    .hero-socials a:hover {
        transform: translateY(-3px);
        color: #fff;
        background: #cda6ed;
    }

    @media (max-width: 1023px) {
        .pixel-portrait-wrap {
            --portrait-size: min(74vw, 480px);
            width: var(--portrait-size);
        }
    }

    @media (max-width: 640px) {
        .home-hero {
            min-height: 100svh;
            height: 100svh;
        }

        .hero-shell {
            justify-content: center;
            transform: translateY(8svh);
        }

        .pixel-portrait-wrap {
            --portrait-size: min(88vw, 520px);
            width: var(--portrait-size);
        }

        .pixel-name {
            font-size: clamp(1.75rem, 9.2vw, 2.55rem);
            letter-spacing: 0;
            text-shadow: 4px 4px 0 rgb(45 53 83 / 0.62);
            transform: none;
        }

        .pixel-bracket {
            text-shadow: 3px 3px 0 #cda6ed, 5px 5px 0 rgb(45 53 83 / 0.45);
        }

        .real-name {
            font-size: clamp(1.15rem, 5.6vw, 1.55rem);
            letter-spacing: 0.1em;
            white-space: normal;
        }

        .role-line {
            font-size: clamp(1rem, 4.8vw, 1.25rem);
            width: 100%;
            justify-content: center;
            text-align: center;
            gap: 0.6rem;
        }

        .hero-socials {
            gap: 0.65rem;
            margin-top: 1.1rem;
        }

        .hero-socials a {
            width: 2.65rem;
            height: 2.65rem;
        }
    }
</style>
