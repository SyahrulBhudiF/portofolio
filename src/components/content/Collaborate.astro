---
import Contact from "../Contact";
---

<section
    class="text-white w-full h-fit flex flex-col items-center relative z-10 px-16 pt-20 pb-32 max-md:px-4 max-md:pt-14 max-md:pb-28"
    id="collaborate"
>
    <div class="flex w-full max-w-6xl flex-col items-center gap-8">
        <div class="flex w-full flex-col gap-4 z-20 justify-center">
            <h2 class="section-title text-center">
                Bring a problem
            </h2>
            <p class="text-base text-purple-200/65 text-center max-sm:text-sm">
                Email is the fastest way to reach me.
            </p>
        </div>

        <div class="w-full max-w-lg z-20">
            <Contact />
        </div>
    </div>
</section>
