---
import { getCollection } from "astro:content";
import AboutMotion from "../AboutMotion";
import TechStackTabs from "../TechStackTabs";

// Get tech stack from content collection
const techstackRaw = await getCollection("techstack");
const techStackCategories = techstackRaw.sort((a, b) => a.data.order - b.data.order);
---

<section
    class="relative z-10 flex h-fit w-full items-start justify-center px-16 pt-20 pb-20 max-md:px-4 max-md:pt-14 max-md:pb-14"
    id="about"
>
    <AboutMotion client:idle>
        <TechStackTabs
                categories={techStackCategories.map((category) => ({
                    title: category.data.title,
                    items: category.data.items,
                }))}
                client:idle
        />
    </AboutMotion>
</section>
