---
import { getCollection } from "astro:content";
import OpenSourceContributions from "@/components/OpenSourceContributions.astro";
import ProjectsContainer from "@/components/ProjectsContainer";
import { getGitHubStars } from "@/lib/github";
import type { Project } from "@/model/projects";

const personalProjects = await getCollection("projects");
const sortedPersonalProjects = personalProjects.sort((a: Project, b: Project) =>
  a.data.date > b.data.date ? -1 : 1,
);

// Two full rows of the two-up grid, so the fold never lands on a lone card.
const initialProjects = sortedPersonalProjects.slice(0, 4);
const remainingProjects = sortedPersonalProjects.slice(4);
const projectStars = await getGitHubStars(
  sortedPersonalProjects.flatMap(({ data }) => [
    data.sourceClient,
    data.sourceServer,
    data.sourceModel,
  ]),
);
---
<section
        class="text-white w-full h-fit flex justify-center relative z-10 px-16 pt-14 pb-14 max-md:px-4 max-md:pt-10 max-md:pb-10"
        id="projects">
    <div class="flex flex-col gap-16 max-md:gap-12 z-10 items-center w-full max-w-6xl">
        <div class="flex w-full flex-col items-center gap-8">
            <h2 class="section-title">Projects</h2>
            <ProjectsContainer
                    initialProjects={initialProjects}
                    remainingProjects={remainingProjects}
                    stars={projectStars}
                    client:idle
            />
        </div>
        <OpenSourceContributions />
    </div>
</section>
