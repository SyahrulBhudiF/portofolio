---
import { getCollection } from "astro:content";
import Contact from "../Contact";
import ExperienceExplorer from "../ExperienceExplorer";

const workExperiences = (await getCollection("experiences")).sort(
  (a, b) => a.data.order - b.data.order,
);
const educationExperiences = (await getCollection("education")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
    class="text-white w-full h-fit flex flex-col items-center relative z-10 px-16 pt-14 pb-28 max-md:px-4 max-md:pt-10 max-md:pb-24"
    id="experience"
>
  <div class="flex w-full max-w-6xl flex-col items-center gap-16 max-md:gap-12">
    <div class="flex w-full flex-col items-center gap-8">
    <h2 class="section-title text-center">
        Experience
    </h2>
    <div class="w-full z-20">
        <ExperienceExplorer
            groups={[
                {
                    label: "Work Experience",
                    items: workExperiences.map((e) => ({
                        title: e.data.company,
                        subtitle: e.data.position,
                        duration: e.data.duration,
                        location: e.data.location,
                        description: e.data.description,
                        tags: e.data.tags,
                        skills: e.data.technologies,
                    })),
                },
                {
                    label: "Education",
                    items: educationExperiences.map((e) => ({
                        title: e.data.institution,
                        subtitle: e.data.degree,
                        duration: e.data.duration,
                        location: e.data.location,
                        description: e.data.description,
                        tags: e.data.tags,
                        skills: e.data.achievements,
                    })),
                },
            ]}
            client:idle
        />
    </div>
    </div>

    <div class="flex w-full flex-col items-center gap-8">
        <div class="flex w-full flex-col gap-4 z-20 justify-center">
            <h2 class="section-title text-center">
                Want to Collaborate?
            </h2>
            <p class="text-lg text-purple-200/85 text-center max-sm:text-base">
                Let's Have a Chat
            </p>
            <p class="text-base text-purple-200/65 text-center max-sm:text-sm">
                Feel free to reach out to me if you have any questions, want to
                collaborate on a project, or just want to chat. I'm always open to
                new opportunities and connections.
            </p>
        </div>

        <div class="w-full max-w-lg z-20">
            <Contact />
        </div>
    </div>
  </div>
</section>
