---
import { getCollection } from "astro:content";
import Contact from "../Contact";
import ExperienceCardGrid from "./ExperienceCardGrid.astro";

const workExperiences = (await getCollection("experiences")).sort(
  (a, b) => a.data.order - b.data.order,
);
const educationExperiences = (await getCollection("education")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
    class="text-white w-full h-full max-xl:h-fit max-lg:pb-24 flex flex-col items-center justify-between relative z-10 pb-20 px-16 max-md:px-4"
    id="experience"
>
    <h2 class="text-retro text-6xl text-center max-sm:text-5xl mb-8">
        Experience
    </h2>
    <div class="w-full max-w-6xl z-20 mt-10 flex flex-col gap-12">
        <ExperienceCardGrid
            title="Work"
            items={workExperiences.map((e) => ({
                title: e.data.company,
                subtitle: e.data.position,
                duration: e.data.duration,
                location: e.data.location,
                description: e.data.description,
                tags: e.data.tags,
                skills: e.data.technologies,
            }))}
        />

        <ExperienceCardGrid
            title="Education"
            items={educationExperiences.map((e) => ({
                title: e.data.institution,
                subtitle: e.data.degree,
                duration: e.data.duration,
                location: e.data.location,
                description: e.data.description,
                tags: e.data.tags,
                skills: e.data.achievements,
            }))}
        />
    </div>

    <div class="w-full max-w-6xl flex flex-col gap-2 z-20 mt-26 max-xl:mt-30 justify-center">
        <h2 class="text-retro text-6xl text-center max-sm:text-5xl">
            Want to Collaborate?
        </h2>
        <p class="text-lg text-white/80 text-center mt-4 max-sm:text-base">
            Let's Have a Chat
        </p>
        <p class="text-base text-white/70 text-center max-sm:text-sm">
            Feel free to reach out to me if you have any questions, want to
            collaborate on a project, or just want to chat. I'm always open to
            new opportunities and connections.
        </p>
    </div>

    <div class="w-full max-w-lg mt-4 z-20">
        <Contact />
    </div>
</section>
