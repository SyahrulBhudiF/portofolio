---
import { getCollection } from "astro:content";
import ContributionList from "@/components/ContributionList";
import { getGitHubStars } from "@/lib/github";

const contributions = await getCollection("contributions");
const contributionStars = await getGitHubStars(contributions.map(({ data }) => data.repository));

/** "https://github.com/org/repo/pull/101" -> "#101" */
const refLabel = (url: string, fallback: string) => {
  const number = url.match(/\/(\d+)\/?$/)?.[1];
  return number ? `#${number}` : fallback;
};

const singleLinkKeys = [
  ["pullRequest", "PR"],
  ["commit", "Commit"],
] as const;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric" });

// Newest entry first inside a repo, repos ordered by their newest entry.
const repos = contributions
  .map(({ data }) => {
    const entries = [...data.entries]
      .sort((a, b) => b.date.getTime() - a.date.getTime())
      .map((entry) => ({
        title: entry.title,
        description: entry.description,
        highlights: entry.highlights,
        dateLabel: formatDate(entry.date),
        dateISO: entry.date.toISOString(),
        links: [
          ...singleLinkKeys.flatMap(([key, fallback]) => {
            const url = entry[key];
            return url ? [{ label: refLabel(url, fallback), url }] : [];
          }),
          ...entry.issues.map((url) => ({ label: refLabel(url, "Issue"), url })),
        ],
      }));

    return {
      title: data.title,
      repository: data.repository,
      stars: contributionStars[data.repository] ?? 0,
      entries,
      latest: entries[0].dateISO,
    };
  })
  .sort((a, b) => (a.latest > b.latest ? -1 : 1));

const mergedCount = repos.reduce((total, repo) => total + repo.entries.length, 0);
---

<div class="w-full mt-4 pt-8">
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 mb-6">
    <div>
      <p class="text-retro text-4xl max-sm:text-3xl">Open Source</p>
      <p class="mt-1 text-sm text-purple-200/80">Merged contributions to tools I use.</p>
    </div>
    <span class="font-mono text-xs tracking-[0.2em] text-purple-300/70">
      {String(mergedCount).padStart(2, "0")} MERGED
    </span>
  </div>

  <ContributionList repos={repos} client:visible />

  {/* The cards ship with framer's initial opacity:0; keep them readable without JS. */}
  <noscript>
    <style>
      .pixel-card {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>
</div>
