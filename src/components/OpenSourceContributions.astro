---
import GitHubStars from "@/components/GitHubStars";
import { getGitHubStars } from "@/lib/github";
import { ExternalLink } from "lucide-react";

const contributions = [
  {
    name: "pi-btw",
    description:
      "Added mouse-wheel, touchpad, and arrow-key transcript scrolling to the BTW side-conversation overlay.",
    url: "https://github.com/dbachelder/pi-btw/commit/88980a42076eb0f5e197345ad0e5d78697d00231",
    repository: "https://github.com/dbachelder/pi-btw",
    date: "May 2026",
  },
  {
    name: "codemogger",
    description:
      "Improved SQLite indexing reliability with transactional stale-file cleanup and bounded embedding retrieval.",
    url: "https://github.com/glommer/codemogger/commit/5156917274f14dcd0dbedfe950a1bbff53bded81",
    repository: "https://github.com/glommer/codemogger",
    date: "Feb 2026",
  },
];
const contributionStars = await getGitHubStars(contributions.map(({ repository }) => repository));
---

<div class="w-full mt-8 border-t border-purple-300/30 pt-8">
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 mb-5">
    <div>
      <p class="text-retro text-4xl max-sm:text-3xl">Open Source</p>
      <p class="mt-1 text-sm text-purple-200/80">Merged contributions to tools I use.</p>
    </div>
    <span class="font-mono text-xs tracking-[0.2em] text-purple-300/70">02 MERGED</span>
  </div>

  <ul class="border-y border-purple-300/25 divide-y divide-purple-300/20">
    {
      contributions.map((contribution, index) => (
        <li>
          <a
            href={contribution.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group grid grid-cols-[auto_1fr_auto] items-start gap-x-4 gap-y-1 py-4 outline-none transition-colors hover:bg-purple-500/10 focus-visible:bg-purple-500/10 max-sm:grid-cols-[auto_1fr]"
          >
            <span class="mt-0.5 font-mono text-sm text-purple-400">0{index + 1}</span>
            <span>
              <span class="flex items-center gap-2 font-mono text-lg text-white group-hover:text-purple-200">
                {contribution.name}
                <ExternalLink size={14} aria-hidden="true" className="text-purple-300" />
              </span>
              <span class="mt-1 block text-sm leading-relaxed text-gray-300">{contribution.description}</span>
            </span>
            <span class="flex items-center gap-3 font-mono text-xs text-purple-200/70 max-sm:col-start-2">
              <GitHubStars
                stars={contributionStars[contribution.repository] ?? 0}
                size={13}
                className="text-purple-200/70"
              />
              <time>{contribution.date}</time>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
